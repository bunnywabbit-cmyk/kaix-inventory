{
  "name": "kaix-inventory",
  "private": true,
  "version": "0.1.0",
  "description": "Screen Printing Inventory Management System",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
